# Environment variables (CRITICAL - contains secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Dependencies
node_modules/

# Build output (Vercel builds on deploy)
dist/
build/
.next/
out/

# Test coverage (generated)
coverage/

# IDE and editor files
.vscode/
.idea/
.idx/
*.sublime-*
*.swp
*.swo
*~

# Nix/Flake (environment specific)
flake.nix
flake.lock
*.nix

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase
supabase/.temp/
supabase/.branches/

# Husky (local git hooks)
.husky/_/

# Temporary files
*.tmp
*.temp
.cache/
tmp/
temp/

# Type declaration maps
*.d.ts.map

# Python (if test scripts exist)
__pycache__/
*.py[cod]
*.pyo
test.py

# Certificates and keys (CRITICAL)
*.pem
*.key
*.cert
*.crt

# Database files
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup
